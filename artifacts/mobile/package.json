    "@react-navigation/native": "^7.0.0",
    "@tanstack/react-query": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
