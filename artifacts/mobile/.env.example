# Base URL of the deployed API server (no trailing slash, no /api suffix —
# src/api.ts appends /api for you).
#
# Simulator against a local API:  http://localhost:5000
# Physical device on the same LAN: http://192.168.1.x:5000
# Replit deployment:               https://your-repl-name.replit.app
EXPO_PUBLIC_API_BASE_URL=https://your-repl-name.replit.app

# --- Google sign-in (optional) ----------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials. The AuthSession
# flow used in Expo Go needs the *Web* client ID; a native/dev build also uses
# the *iOS* client ID. The API server's GOOGLE_CLIENT_IDS must list whichever
# of these the app can present.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Apple sign-in needs no client-side key — it uses the app's bundle identifier.
# Set that in app.json (ios.bundleIdentifier) and list it in the API server's
# APPLE_CLIENT_IDS. The Apple button only appears in a dev/production build,
# not Expo Go.
