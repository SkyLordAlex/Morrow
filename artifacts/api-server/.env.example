# --- Core ---------------------------------------------------------------------
# Postgres connection string. Local Docker or a free Neon/Supabase database.
DATABASE_URL=postgres://user:password@localhost:5432/study_planner

# Port the API listens on. The web app's vite proxy and the mobile .env both
# assume 5000 for local dev.
PORT=5000

# `development` turns on pretty logging. Leave unset / set `production` in prod.
NODE_ENV=development

# --- Sessions ----------------------------------------------------------------
# How long a bearer session stays valid. Optional; defaults to 30.
SESSION_TTL_DAYS=30

# --- Sign in with Apple ----------------------------------------------------
# Comma-separated list of allowed audiences for the Apple identity token.
# Put your iOS app's bundle identifier here, and the Services ID if you also
# offer Apple sign-in on the web.
#   e.g. APPLE_CLIENT_IDS=com.yourco.morrow,com.yourco.morrow.web
APPLE_CLIENT_IDS=

# --- Google sign-in --------------------------------------------------------
# Comma-separated list of allowed audiences for the Google ID token. Include
# every OAuth client ID a client might present: the iOS client ID and the Web
# client ID used by the Expo AuthSession flow and the web app.
#   e.g. GOOGLE_CLIENT_IDS=1234-ios.apps.googleusercontent.com,1234-web.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# --- Admins ---------------------------------------------------------------
# Comma-separated emails auto-granted the admin role when they sign in.
# Admins can moderate reviews and open the admin console. Only ever grants —
# to remove an admin, use the admin console or clear their role in the DB.
#   e.g. ADMIN_EMAILS=you@yourdomain.com,cofounder@yourdomain.com
ADMIN_EMAILS=

# --- AI plan generation --------------------------------------------------
# Free Google Gemini API key: https://aistudio.google.com/app/apikey
# When set, POST /planner/plans sends the student's note to Gemini and turns
# the reply into assignments + study tasks. When unset — or if the request
# errors / times out / hits the free-tier rate limit — it falls back to the
# built-in keyword parser, so plan creation always works.
GEMINI_API_KEY=
# Optional. Any free-tier model works; gemini-2.5-flash is a good default.
GEMINI_MODEL=gemini-2.5-flash
