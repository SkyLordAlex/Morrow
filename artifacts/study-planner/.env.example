# Required by vite.config.ts
PORT=5173
BASE_PATH=/

# Dev-only: where the vite `/api` proxy forwards requests. Point at the API
# server. Defaults to http://localhost:5000 when unset.
VITE_API_PROXY_TARGET=http://localhost:5000

# Production only: absolute URL of the deployed API (protocol optional). Baked
# into the bundle at build time. Leave blank for local dev (the proxy handles it).
VITE_API_URL=

# Optional social sign-in. Leave blank to show only email/password.
# Google OAuth *Web* client ID (from Google Cloud Console → Credentials).
VITE_GOOGLE_CLIENT_ID=
# Apple *Services ID* (from the Apple Developer portal), plus the domain and
# return URL registered there must match where you host this app.
VITE_APPLE_CLIENT_ID=
